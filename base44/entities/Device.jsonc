{
  "name": "Device",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "operator": {
      "type": "string"
    },
    "last_pull_at": {
      "type": "string"
    },
    "last_push_at": {
      "type": "string"
    },
    "participants_count": {
      "type": "number"
    },
    "app_version": {
      "type": "string"
    }
  },
  "required": [
    "device_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}