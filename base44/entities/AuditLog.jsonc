{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "participant_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "session": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "timestamp"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}