{
  "name": "ReserveToken",
  "type": "object",
  "properties": {
    "token": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "UNUSED",
        "ASSIGNED",
        "REVOKED"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "UNUSED"
    },
    "batch": {
      "type": "string"
    },
    "assigned_participant_id": {
      "type": "string"
    },
    "assigned_at": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "token",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}