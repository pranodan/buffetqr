{
  "name": "Staff",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "registration",
        "buffet"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow"
      ],
      "default": "registration"
    }
  },
  "required": [
    "email",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}